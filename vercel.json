
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web_frontend": {
      "root": "frontend/"
    },
    "api_backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api_backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api_backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web_frontend"
      }
    }
  ]
}
